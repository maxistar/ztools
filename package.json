{
  "name": "@ztools.org/runtime",
  "version": "0.0.3",
  "description": "Tiny DOM-first reactive UI runtime",
  "type": "module",
  "main": "./ztools.js",
  "module": "./ztools.js",
  "types": "./ztools.d.ts",
  "exports": {
    ".": {
      "types": "./ztools.d.ts",
      "default": "./ztools.js"
    },
    "./client": {
      "types": "./ztools.d.ts",
      "default": "./ztools.client.js"
    },
    "./ssr": {
      "types": "./ztools.d.ts",
      "default": "./ztools.ssr.js"
    },
    "./ztools.client.js": {
      "types": "./ztools.d.ts",
      "default": "./ztools.client.js"
    },
    "./ztools.ssr.js": {
      "types": "./ztools.d.ts",
      "default": "./ztools.ssr.js"
    }
  },
  "files": [
    "ztools.js",
    "ztools.client.js",
    "ztools.ssr.js",
    "ztools.d.ts",
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:full:client": "esbuild ztools.client.js --bundle --format=esm --platform=browser --target=es2020 --outfile=dist/ztools.client.full.js",
    "build:full:ssr": "esbuild ztools.ssr.js --bundle --format=esm --platform=node --target=node20 --outfile=dist/ztools.ssr.full.js",
    "build:full": "npm run build:full:client && npm run build:full:ssr",
    "build:docs": "node ./scripts/build-docs-from-md.mjs",
    "build:pages": "npm run build:docs && node ./scripts/build-pages.mjs",
    "generate:ssr-demo": "node ./demo/ssr/generate-ssr-page.mjs"
  },
  "keywords": [
    "reactive",
    "signals",
    "dom",
    "ui"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jsdom": "^24.1.0",
    "markdown-it": "^14.1.1",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "shiki": "^4.0.2"
  }
}
